{
  "uid": "cybersec-apm",
  "title": "CyberSec Saúde — APM",
  "description": "Adaptado do OpenTelemetry APM (rev6) para as métricas HTTP do SDK (ADR-0031): por serviço, sem rota (as métricas não têm http_route).",
  "tags": [
    "cybersec",
    "apm",
    "opentelemetry"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "America/Recife",
  "templating": {
    "list": [
      {
        "name": "servico",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(job)",
          "refId": "servico"
        },
        "definition": "label_values(job)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".+"
      }
    ]
  },
  "links": [
    {
      "title": "Traces (Tempo)",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22:%22tempo%22%7D",
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Visão geral",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Disponibilidade (5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (job) (rate(http_server_duration_milliseconds_count{job=~\"$servico\",http_status_code!~\"5..\"}[5m])) or sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$servico\",http_response_status_code!~\"5..\"}[5m]))) / (sum by (job) (rate(http_server_duration_milliseconds_count{job=~\"$servico\"}[5m])) or sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$servico\"}[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "decimals": 2,
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "description": "Fração de respostas sem erro 5xx (fórmula 3.1). Backend: http_server_duration_milliseconds; frontend: http_server_request_duration_seconds."
    },
